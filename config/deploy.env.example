# ==========================================
# DEPLOYMENT / PRODUCTION ENVIRONMENT EXAMPLE
# Copy this file to deploy.env and configure for production
# ==========================================
APP_NAME="AI Interview Copilot"
APP_VERSION="2.0.0"
ENVIRONMENT="production"
DEBUG=False
HOST="0.0.0.0"
PORT=8000

# LLM Routing Flag
USE_OPEN_SOURCE=False

# Cloud API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Production Local LLM Endpoint
LOCAL_LLM_BASE_URL=http://ollama-service:11434
LOCAL_LLM_MODEL=llama3.2

# Vector Embeddings
LOCAL_EMBED=False
USE_LOCAL_EMBEDDINGS=False
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
LOCAL_EMBEDDING_BASE_URL=http://ollama-service:11434
LOCAL_EMBEDDING_MODEL=nomic-embed-text
