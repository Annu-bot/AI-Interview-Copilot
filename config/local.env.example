# ==========================================
# LOCAL DEVELOPMENT ENVIRONMENT EXAMPLE
# Copy this file to local.env and add your key
# ==========================================
APP_NAME="AI Interview Copilot"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# LLM Routing Flag
# False = Cloud API (Google Gemini)
# True  = Local Open Source LLM (Ollama)
USE_OPEN_SOURCE=False

# Cloud API Configuration
# Get key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local Open-Source LLM Configuration
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2
