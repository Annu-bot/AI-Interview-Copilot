# ==========================================
# Application Settings
# ==========================================
APP_NAME="AI Interview Copilot"
APP_VERSION="2.0.0"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# ==========================================
# LLM Provider Configuration
# ==========================================
# Set to True to route to local open-source models (e.g. Ollama)
# Set to False to route to Cloud APIs (Default: Google Gemini)
USE_OPEN_SOURCE=False

# Cloud API Configuration (Used when USE_OPEN_SOURCE=False)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local Open-Source LLM Configuration (Reserved for when USE_OPEN_SOURCE=True)
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2

# ==========================================
# V2: Embeddings & RAG Configuration
# ==========================================
# Set to True to use local embedding models (Ollama nomic-embed-text)
# Set to False to use Cloud embeddings (Google Gemini text-embedding-004)
LOCAL_EMBED=False
USE_LOCAL_EMBEDDINGS=False

GEMINI_EMBEDDING_MODEL=models/text-embedding-004
LOCAL_EMBEDDING_BASE_URL=http://localhost:11434
LOCAL_EMBEDDING_MODEL=nomic-embed-text
